# Build directives: platform and development-stage
DEVSTAGE=production
# devstage options: production, prototype
PLATFORM=web
# platform options: web,desktop,android,ios

# expo variables
EXPO_PUBLISH=false
# false - development on localhost, true - published on github pages
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=351313377480-s6i2rlnva718kncguoqkf4hu2gtefcrn.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_TAURI_CLIENT_ID=foodlog-desktop-placeholder.apps.googleusercontent.com
EXPO_PUBLIC_AUTH_REDIRECT_ROOT=https://localhost:8081/
EXPO_PUBLIC_AUTH_REDIRECT_FOLDER=auth
EXPO_PUBLIC_DESKTOP_AUTH_REDIRECT=foodlog://auth/
CLOUDFLARE_STORAGE_URL=https://foodlog-storage.pashute.workers.dev/

# localhost web redirect: https://localhost:8081/auth/ 
# github web redirect:    https://pashute.github.io/foodlog/auth/
