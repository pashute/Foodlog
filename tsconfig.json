{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noCheck": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.ts"]
}