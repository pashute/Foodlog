{
  "name": "foodlog",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:bdd": "cucumber-js",
    "test:unit": "node --test dev/testing/units/**/*.test.js",
    "test:ui": "jest",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@tauri-apps/api": "^2.0.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-secure-store": "~14.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "playwright": "^1.62.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/dev/testing/units/screens/tauri/**/*.test.jsx"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "\\.(png|jpg|jpeg|gif)$": "<rootDir>/dev/testing/fileMock.js"
    }
  }
}
