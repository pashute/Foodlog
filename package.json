{
  "name": "foodlog",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test:bdd": "tsx ./node_modules/@cucumber/cucumber/bin/cucumber-js",
    "test:unit": "tsx --test dev/testing/units/**/*.test.ts",
    "test:ui": "jest --runInBand",
    "dev": "npm run web",
    "web": "concurrently \"npm:mock:sheet-server\" \"expo start --web\"",
    "mock:sheet-server": "tsx src/prototype/sheet/sheetServer.ts"
  },
  "dependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.4",
    "expo": "^57.0.18",
    "expo-auth-session": "~57.0.10",
    "expo-crypto": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/dev/testing/units/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "\\.(png|jpg|jpeg|gif)$": "<rootDir>/dev/testing/fileMock.ts"
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/jest": "29.5.14",
    "@types/react": "^19.2.18",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "^57.0.9",
    "concurrently": "^10.0.5",
    "enquirer": "^2.4.1",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.5.0",
    "tsx": "^4.23.13"
  }
}
